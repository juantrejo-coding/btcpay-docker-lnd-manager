msgstr ""

#: serverb/serverb-dashboard.py:102
#, python-format
msgid "Asks bitcoincore.org and api.github.com for the latest releases and compares them with what is installed. It also does that by itself every 12 hours. Changes nothing."
msgstr ""

#: serverb/serverb-dashboard.py:104
#, python-format
msgid "install the latest Bitcoin Core"
msgstr ""

#: serverb/serverb-dashboard.py:105
#, python-format
msgid "Downloads the latest Bitcoin Core release, checks its signatures (at least 3 builders) and checksum like serverb-bitcoind-setup.sh, installs it and restarts bitcoind, then the watchtower (it loses bitcoind meanwhile): offline for a minute or so. Only while Server A says it is safe (its LND runs, nothing in flight, no channel opening or closing); else it waits up to 24 hours, then installs at the next boot. Nothing is installed if a check fails. You type UPDATE."
msgstr ""

#: serverb/serverb-dashboard.py:110
#, python-format
msgid "install the latest LND for the watchtower"
msgstr ""

#: serverb/serverb-dashboard.py:111
#, python-format
msgid "Downloads the latest LND release, checks its signatures (at least 2 signers) and checksum like serverb-watchtower-setup.sh, installs it and restarts the watchtower: offline for a minute or so. Only while Server A says it is safe, as /update bitcoind. LND updates its database at the first start, so the old version may not open it again. Nothing is installed if a check fails. You type UPDATE."
msgstr ""

#: serverb/serverb-dashboard.py:117
#, python-format
msgid "Gets the newest release of these scripts from GitHub, checks its signature against the release key built in here, and updates the backup gate and this dashboard with the settings serverb-setup.sh saved. bitcoind and the watchtower keep running. You type UPDATE."
msgstr ""

