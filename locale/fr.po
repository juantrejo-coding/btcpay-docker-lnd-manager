msgid "its archive could not be unpacked"
msgstr "son archive n'a pas pu être décompressée"

#: lnd-wallet.sh:597
msgid "it holds links or special files, which the service never backs up"
msgstr "elle contient des liens ou des fichiers spéciaux, que le service ne sauvegarde jamais"

#: lnd-wallet.sh:629
msgid "its signed manifest says it is a '%s' backup, not '%s'"
msgstr "son manifeste signé indique une sauvegarde '%s', et non '%s'"

#: lnd-wallet.sh:633
msgid "its signed manifest has no valid time"
msgstr "son manifeste signé ne contient pas d'heure valide"

#: lnd-wallet.sh:646
