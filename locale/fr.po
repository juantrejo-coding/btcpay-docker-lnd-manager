msgstr "   Le service de sauvegarde lit la copie installée : relancez %s/rsync_gpg_backup.sh pour l'actualiser."

#: install-scripts.sh:232
msgid "   The backup service still reads %s/config: rerun %s/rsync_gpg_backup.sh,"
msgstr "   Le service de sauvegarde lit encore %s/config : relancez %s/rsync_gpg_backup.sh,"

#: install-scripts.sh:233
msgid "   then sudo ./install-scripts.sh again removes %s."
msgstr "   puis un nouveau sudo ./install-scripts.sh supprime %s."

#: install-scripts.sh:239
msgid "   Removed the old install folder %s"
msgstr "   Ancien dossier d'installation %s supprimé"

#: install-scripts.sh:241
