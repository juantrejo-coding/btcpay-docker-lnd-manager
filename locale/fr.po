#: chain-tower.sh
msgid "❌ btcpay-up.sh failed: run %s/btcpay-up.sh by hand"
msgstr "❌ btcpay-up.sh a échoué : lancez %s/btcpay-up.sh à la main"

#: chain-tower.sh
msgid "🚀 Starting BTCPay again..."
msgstr "🚀 Redémarrage de BTCPay..."

#: chain-tower.sh:67 lnd-wallet.sh:93
msgid "❌ Unknown option: %s"
msgstr "❌ Option inconnue : %s"

#: chain-tower.sh:72
msgid "❌ chain-tower.sh needs a terminal for its confirmations."
msgstr "❌ chain-tower.sh a besoin d'un terminal pour ses confirmations."

#: chain-tower.sh:119
msgid "ℹ️ A chain/tower operation is already running in tmux session '%s'. Attaching to it..."
msgstr "ℹ️ Une opération blockchain/tour est déjà en cours dans la session tmux '%s'. Connexion à celle-ci..."

#: chain-tower.sh:121
msgid "ℹ️ That was the earlier operation; this one (%s) was not started."
msgstr "ℹ️ C'était l'opération précédente ; celle-ci (%s) n'a pas été lancée."

#: chain-tower.sh:133
msgid "ℹ️ It is still running in tmux. Back to it: run the same command again."
msgstr "ℹ️ Elle continue dans tmux. Pour y revenir : relancez la même commande."

#: chain-tower.sh:136 lnd-wallet.sh:168
msgid "⚠️ tmux could not start a session. Continuing without it: don't let the SSH connection drop."
msgstr "⚠️ tmux n'a pas pu démarrer de session. Poursuite sans tmux : ne laissez pas la connexion SSH se couper."

#: chain-tower.sh:143 lnd-wallet.sh:179
msgid "Finished (exit code %s). Press Enter to close this tmux session. "
msgstr "Terminé (code de sortie %s). Appuyez sur Entrée pour fermer cette session tmux. "

#: chain-tower.sh:146 lnd-wallet.sh:182
msgid "Finished (exit code %s). Press Enter to go back. "
msgstr "Terminé (code de sortie %s). Appuyez sur Entrée pour revenir. "

#: chain-tower.sh:152
msgid "Another chain-tower.sh is running. Let it finish first."
msgstr "Un autre chain-tower.sh est en cours. Attendez d'abord qu'il se termine."

#: chain-tower.sh:156
msgid "lnd-wallet.sh is running. Let it finish first."
msgstr "lnd-wallet.sh est en cours. Attendez d'abord qu'il se termine."

#: chain-tower.sh:160
msgid "BTCPay isn't installed the usual way (%s, %s)"
msgstr "BTCPay n'est pas installé de la manière habituelle (%s, %s)"

#: chain-tower.sh:169
msgid "⚙️ btcpay-setup.sh with BTCPAYGEN_ADDITIONAL_FRAGMENTS=\"%s\" (BTCPay restarts)..."
msgstr "⚙️ btcpay-setup.sh avec BTCPAYGEN_ADDITIONAL_FRAGMENTS=\"%s\" (BTCPay redémarre)..."

#: chain-tower.sh:176
msgid "btcpay-setup.sh failed (exit code %s); see the lines above. Check BTCPay: %s/btcpay-up.sh"
msgstr "btcpay-setup.sh a échoué (code de sortie %s) ; voir les lignes ci-dessus. Vérifiez BTCPay : %s/btcpay-up.sh"

#: chain-tower.sh:177
msgid "btcpay-setup.sh didn't take the new fragments; see the lines above"
msgstr "btcpay-setup.sh n'a pas pris en compte les nouveaux fragments ; voir les lignes ci-dessus"

#: chain-tower.sh:178
msgid "✅ BTCPay runs with: %s"
msgstr "✅ BTCPay fonctionne avec : %s"

#: chain-tower.sh:196
msgid "⚠️  BTCPay will be stopped: the store can't take payments and Lightning is offline for %s."
msgstr "⚠️  BTCPay va être arrêté : la boutique ne pourra plus recevoir de paiements et Lightning sera hors ligne pendant %s."

#: chain-tower.sh:197 lnd-wallet.sh:890
msgid "Type 'STOP BTCPAY' to stop it: "
msgstr "Tapez 'STOP BTCPAY' pour l'arrêter : "

#: chain-tower.sh:198
msgid "Aborted: BTCPay was not stopped and nothing was changed."
msgstr "Abandon : BTCPay n'a pas été arrêté et rien n'a été modifié."

#: chain-tower.sh:220
msgid "BTCPay's blockchain: %s of blocks, prune=%s"
msgstr "Blockchain de BTCPay : %s de blocs, prune=%s"

#: chain-tower.sh:221
msgid "Fragments now: %s"
msgstr "Fragments actuels : %s"

#: chain-tower.sh:223
msgid "BTCPay's pruning presets keep this much of the blockchain:"
msgstr "Les préréglages d'élagage de BTCPay conservent cette part de la blockchain :"

#: chain-tower.sh:224
msgid "  1) opt-save-storage       ~100 GB"
msgstr "  1) opt-save-storage       ~100 GB"

#: chain-tower.sh:225
msgid "  2) opt-save-storage-s     ~50 GB"
msgstr "  2) opt-save-storage-s     ~50 GB"

#: chain-tower.sh:226
msgid "  3) opt-save-storage-xs    ~25 GB   recommended: keeps about 3 months of blocks"
msgstr "  3) opt-save-storage-xs    ~25 GB   recommandé : conserve environ 3 mois de blocs"

#: chain-tower.sh:227
msgid "  4) opt-save-storage-xxs   ~5 GB    BTCPay warns that Lightning can have trouble with this little"
msgstr "  4) opt-save-storage-xxs   ~5 GB    BTCPay avertit que Lightning peut avoir des problèmes avec si peu"

#: chain-tower.sh:228
msgid "Pruning deletes old blocks: BTCPay can then no longer rescan for transactions older than what it"
msgstr "L'élagage supprime les anciens blocs : BTCPay ne peut plus rechercher de transactions antérieures"

#: chain-tower.sh:229
msgid "keeps (for example when importing an old wallet). Do it only if you have no old transactions to"
msgstr "à ce qu'il conserve (par ex. à l'import d'un ancien portefeuille). À faire seulement sans anciennes"

#: chain-tower.sh:230
msgid "find. Lightning needs blocks back to its oldest channel's opening."
msgstr "transactions à retrouver. Lightning a besoin des blocs depuis l'ouverture de son plus ancien canal."

#: chain-tower.sh:232
msgid "Choose 1-4 (Enter for 3, q to stop): "
msgstr "Choisissez 1-4 (Entrée pour 3, q pour arrêter) : "

#: chain-tower.sh:238 serverb/serverb-dashboard-setup.sh:50
#: serverb/serverb-import-chain.sh:41 serverb/serverb-user-setup.sh:63
#: serverb/serverb-user-setup.sh:67
msgid "Stopped: nothing was changed."
msgstr "Arrêté : rien n'a été modifié."

#: chain-tower.sh:244
msgid "ℹ️ BTCPay already uses %s"
msgstr "ℹ️ BTCPay utilise déjà %s"

#: chain-tower.sh:245
msgid "a few minutes, while btcpay-setup.sh applies %s"
msgstr "quelques minutes, pendant que btcpay-setup.sh applique %s"

#: chain-tower.sh:247
msgid "✅ BTCPay's blockchain is pruned to %s; bitcoind deletes old blocks as it starts."
msgstr "✅ La blockchain de BTCPay est élaguée avec %s ; bitcoind supprime les anciens blocs au démarrage."

#: chain-tower.sh:253
msgid "SERVER_B_USER or REMOTE_SERVER is empty in config. Run setup first."
msgstr "SERVER_B_USER ou REMOTE_SERVER est vide dans config. Lancez d'abord la configuration."

#: chain-tower.sh:254
msgid "No blockchain in %s (BITCOIND_DIR in config)"
msgstr "Aucune blockchain dans %s (BITCOIND_DIR dans config)"

#: chain-tower.sh:261
msgid "There is no user %s (SERVER_A_USER in config)"
msgstr "L'utilisateur %s n'existe pas (SERVER_A_USER dans config)"

#: chain-tower.sh:264
msgid "Server B's backup gate doesn't answer. Run setup first (lnd-manager: /setup)."
msgstr "La passerelle de sauvegarde du serveur B ne répond pas. Lancez d'abord la configuration (lnd-manager : /setup)."

#: chain-tower.sh:267
msgid "BTCPay's blockchain: %s GB (prune=%s), to %s:~/chain-incoming"
msgstr "Blockchain de BTCPay : %s GB (prune=%s), vers %s:~/chain-incoming"

#: chain-tower.sh:269
msgid "⚠️  It isn't pruned: all of it would be copied (hundreds of GB). Prune it first: /chain prune."
msgstr "⚠️  Elle n'est pas élaguée : elle serait copiée en entier (des centaines de GB). Élaguez-la d'abord : /chain prune."

#: chain-tower.sh:270 chain-tower.sh:280
msgid "Stopped: nothing was copied."
msgstr "Arrêté : rien n'a été copié."

#: chain-tower.sh:270
msgid "Type 'COPY ALL' to copy it unpruned anyway: "
msgstr "Tapez 'COPY ALL' pour la copier quand même sans élagage : "

#: chain-tower.sh:273
msgid "Two passes, so BTCPay is down only for the second:"
msgstr "Deux passes, pour que BTCPay ne soit arrêté que pendant la seconde :"

#: chain-tower.sh:274
msgid "  1. while BTCPay runs: almost everything (%s GB). This can take hours; BTCPay keeps working."
msgstr "  1. BTCPay en marche : presque tout (%s GB). Cela peut prendre des heures ; BTCPay reste en service."

#: chain-tower.sh:275
msgid "     If the connection drops, run /chain copy again: it goes on where it stopped."
msgstr "     Si la connexion se coupe, relancez /chain copy : la copie reprend là où elle s'est arrêtée."

#: chain-tower.sh:276
msgid "  2. BTCPay stopped (you type STOP BTCPAY): only what changed meanwhile, usually minutes."
msgstr "  2. BTCPay arrêté (vous tapez STOP BTCPAY) : uniquement les changements depuis, souvent quelques minutes."

#: chain-tower.sh:277
msgid "     Then BTCPay starts again."
msgstr "     Ensuite BTCPay redémarre."

#: chain-tower.sh:278
msgid "Server B's gate takes it only into ~%s/chain-incoming (serverb-bitcoind-setup.sh makes it)."
msgstr "La passerelle du serveur B ne l'accepte que dans ~%s/chain-incoming (créé par serverb-bitcoind-setup.sh)."

#: chain-tower.sh:279
msgid "Afterwards, on Server B: sudo bash serverb-import-chain.sh"
msgstr "Ensuite, sur le serveur B : sudo bash serverb-import-chain.sh"

#: chain-tower.sh:280
msgid "Start the copy? Type yes: "
msgstr "Lancer la copie ? Tapez yes : "

#: chain-tower.sh:286
msgid "📤 Pass 1 of 2: copying while BTCPay runs..."
msgstr "📤 Passe 1 sur 2 : copie pendant que BTCPay tourne..."

#: chain-tower.sh:293
msgid "⚠️ Pass 1 ended with code %s (files changing while BTCPay runs, expected). Going on to pass 2, which copies the rest."
msgstr "⚠️ La passe 1 s'est terminée avec le code %s (des fichiers changent pendant que BTCPay tourne, c'est normal). Passage à la passe 2, qui copie le reste."

#: chain-tower.sh:294
msgid "Pass 1 failed (rsync exit code %s), so BTCPay was not stopped. Fix what the lines above say, then run /chain copy again."
msgstr "La passe 1 a échoué (code de sortie rsync %s), donc BTCPay n'a pas été arrêté. Corrigez ce qu'indiquent les lignes ci-dessus, puis relancez /chain copy."

#: chain-tower.sh:296
msgid "a few minutes, while the rest of the blockchain is copied"
msgstr "quelques minutes, pendant la copie du reste de la blockchain"

#: chain-tower.sh:299
msgid "🛑 Stopping BTCPay (btcpay-down.sh)..."
msgstr "🛑 Arrêt de BTCPay (btcpay-down.sh)..."

#: chain-tower.sh:300
msgid "btcpay-down.sh failed"
msgstr "btcpay-down.sh a échoué"

#: chain-tower.sh:301
msgid "📤 Pass 2 of 2: copying the rest with BTCPay stopped..."
msgstr "📤 Passe 2 sur 2 : copie du reste avec BTCPay arrêté..."

#: chain-tower.sh:302
msgid "Pass 2 failed. BTCPay is started again; run /chain copy again later."
msgstr "La passe 2 a échoué. BTCPay redémarre ; relancez /chain copy plus tard."

#: chain-tower.sh:303
msgid "✅ Blockchain copied to Server B. Next, on Server B: sudo bash serverb-import-chain.sh"
msgstr "✅ Blockchain copiée sur le serveur B. Ensuite, sur le serveur B : sudo bash serverb-import-chain.sh"

#: chain-tower.sh:309
msgid "WATCHTOWER_PUBKEY in config isn't a public key (66 hex characters)"
msgstr "WATCHTOWER_PUBKEY dans config n'est pas une clé publique (66 caractères hexadécimaux)"

#: chain-tower.sh:310
msgid "WATCHTOWER_IP in config isn't set"
msgstr "WATCHTOWER_IP n'est pas défini dans config"

#: chain-tower.sh:311
msgid "WATCHTOWER_PORT in config isn't a port"
msgstr "WATCHTOWER_PORT dans config n'est pas un port"

#: chain-tower.sh:315
msgid "BTCPay's LND has its watchtower client off. BTCPay's opt-lnd-wtclient fragment turns it on"
msgstr "Le LND de BTCPay a son client watchtower désactivé. Le fragment opt-lnd-wtclient de BTCPay l'active"

#: chain-tower.sh:316
msgid "(wtclient.active=1); btcpay-setup.sh applies it and restarts LND."
msgstr "(wtclient.active=1) ; btcpay-setup.sh l'applique et redémarre LND."

#: chain-tower.sh:317
msgid "a few minutes, while btcpay-setup.sh turns on the watchtower client"
msgstr "quelques minutes, pendant que btcpay-setup.sh active le client watchtower"

#: chain-tower.sh:321
msgid "⏳ Waiting for LND..."
msgstr "⏳ Attente de LND..."

#: chain-tower.sh:322
msgid "LND doesn't answer (docker logs %s)"
msgstr "LND ne répond pas (docker logs %s)"

#: chain-tower.sh:325
msgid "⏳ LND is still catching up with the chain; the watchtower client waits for that (up to 10 minutes here)..."
msgstr "⏳ LND se synchronise encore avec la blockchain ; le client watchtower l'attend (ici jusqu'à 10 minutes)..."

#: chain-tower.sh:327
msgid "➕ Adding the watchtower %s..."
msgstr "➕ Ajout de la watchtower %s..."

#: chain-tower.sh:331
msgid "LND's watchtower client didn't answer within 10 minutes (LND not synced to the chain yet?). The client is on; run /tower add again later."
msgstr "Le client watchtower de LND n'a pas répondu en 10 minutes (LND pas encore synchronisé avec la blockchain ?). Le client est activé ; relancez /tower add plus tard."

#: chain-tower.sh:332
msgid "lncli wtclient add failed"
msgstr "lncli wtclient add a échoué"

#: chain-tower.sh:334
msgid "✅ The watchtower is added. LND sends it encrypted channel updates from now on."
msgstr "✅ La watchtower est ajoutée. Désormais, LND lui envoie les mises à jour chiffrées des canaux."

#: chain-tower.sh:342
msgid "The watchtower client isn't on, LND isn't running, or LND is still catching up with the chain:"
msgstr "Le client watchtower n'est pas activé, LND ne tourne pas, ou LND se synchronise encore avec la blockchain :"

#: chain-tower.sh:346
msgid "Towers:"
msgstr "Tours :"

#: chain-tower.sh:348
msgid "Statistics:"
msgstr "Statistiques :"

#: config-lib.sh:16 config-lib.sh:41
msgid "❌ Expected exactly one %s= line in %s"
msgstr "❌ Exactement une ligne %s= attendue dans %s"

#: config-lib.sh:24
msgid "❌ Could not write %s (the original is saved in %s)"
msgstr "❌ Impossible d'écrire %s (l'original est enregistré dans %s)"

#: config-lib.sh:30
msgid "❌ Failed to reload %s with %s=\"%s\""
msgstr "❌ Échec du rechargement de %s avec %s=\"%s\""

#: config-lib.sh:33
msgid "✅ Saved %s=\"%s\" in %s"
msgstr "✅ %s=\"%s\" enregistré dans %s"

#: config-lib.sh:60 rsync_gpg_backup.sh:301
msgid "❌ Not allowed: %s"
msgstr "❌ Non autorisé : %s"

#: config-lib.sh:69
msgid "❌ %s in config is not allowed: %s"
msgstr "❌ La valeur de %s dans config n'est pas autorisée : %s"

#: config-lib.sh:78
msgid "enter a hostname or IP address (letters, digits, '.', ':' and '-', no user@ or spaces)"
msgstr "saisissez un nom d'hôte ou une adresse IP (lettres, chiffres, '.', ':' et '-', sans user@ ni espaces)"

#: config-lib.sh:86 serverb-scripts.sh:82
msgid "use up to 32 lowercase letters, digits, _ or -, starting with a letter"
msgstr "utilisez au plus 32 lettres minuscules, chiffres, _ ou -, en commençant par une lettre"

#: config-lib.sh:88
msgid "use a normal user on Server B, not root"
msgstr "utilisez un utilisateur normal sur le serveur B, pas root"

#: config-lib.sh:95
msgid "enter a port number from 1 to 65535"
msgstr "saisissez un numéro de port de 1 à 65535"

#: config-lib.sh:177
msgid "❌ Could not add the new settings to %s"
msgstr "❌ Impossible d'ajouter les nouveaux réglages à %s"

#: config-lib.sh:183
msgid "❌ Failed to reload %s after adding new settings"
msgstr "❌ Échec du rechargement de %s après l'ajout des nouveaux réglages"

#: config-lib.sh:186
msgid "✅ Updated %s: %s"
msgstr "✅ %s mis à jour : %s"

#: install-scripts.sh
msgid "❌ %s has a syntax error"
msgstr "❌ %s contient une erreur de syntaxe"

#: install-scripts.sh
msgid "❌ Missing %s/%s"
msgstr "❌ %s/%s manquant"

#: install-scripts.sh
msgid "❌ Missing %s/LICENSE"
msgstr "❌ %s/LICENSE manquant"

#: install-scripts.sh:37
msgid "❌ BACKUP_INSTALL_DIR must be under /usr/local or /opt: %s"
msgstr "❌ BACKUP_INSTALL_DIR doit se trouver sous /usr/local ou /opt : %s"

#: install-scripts.sh:40
msgid "❌ Run this from your working folder, not from %s"
msgstr "❌ Lancez ceci depuis votre dossier de travail, pas depuis %s"

#: install-scripts.sh:59
msgid "❌ %s is a symlink, not owned by root, or writable by others"
msgstr "❌ %s est un lien symbolique, n'appartient pas à root ou est modifiable par d'autres"

#: install-scripts.sh:107
msgid "✅ Installed into %s (changed: %s)"
msgstr "✅ Installé dans %s (modifié : %s)"

#: install-scripts.sh:109
msgid "✅ %s is up to date"
msgstr "✅ %s est à jour"

#: install-scripts.sh:111
msgid "   Wallet: sudo lnd-wallet [new|restore|channels|channels-only|undo]   Dashboard: lnd-manager"
msgstr "   Portefeuille : sudo lnd-wallet [new|restore|channels|channels-only|undo]  Tableau de bord : lnd-manager"

#: install-scripts.sh:113
msgid "   The backup service uses the installed copy: rerun %s/rsync_gpg_backup.sh to apply the changes."
msgstr "   Le service de sauvegarde lit la copie installée : relancez %s/rsync_gpg_backup.sh pour l'actualiser."

#: install-scripts.sh:122
msgid "   The backup service still reads %s/config: rerun %s/rsync_gpg_backup.sh,"
msgstr "   Le service de sauvegarde lit encore %s/config : relancez %s/rsync_gpg_backup.sh,"

#: install-scripts.sh:123
msgid "   then sudo ./install-scripts.sh again removes %s."
msgstr "   puis un nouveau sudo ./install-scripts.sh supprime %s."

#: install-scripts.sh:129
msgid "   Removed the old install folder %s"
msgstr "   Ancien dossier d'installation %s supprimé"

#: install-scripts.sh:131
msgid "   %s holds files this project didn't put there; left as it is"
msgstr "   %s contient des fichiers que ce projet n'y a pas mis ; laissé tel quel"

