msgstr "✅ Clé privée GPG exportée dans %s comme sauvegarde."

#: setup_script.sh:965
msgid "❌ GPG private key export to %s failed."
msgstr "❌ Échec de l'exportation de la clé privée GPG vers %s."

#: setup_script.sh:969
msgid "Would you like to export and view the private key (for backup)? (y/n): "
msgstr "Voulez-vous exporter et afficher la clé privée (pour la sauvegarder) ? (y/n) : "

#: setup_script.sh:972 setup_script.sh:1004
