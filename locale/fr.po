msgstr "❌ Aucun périphérique trouvé avec l'UUID %s"

#: setup_script.sh:1195
msgid "✅ Device for UUID %s is: %s"
msgstr "✅ Le périphérique de l'UUID %s est : %s"

#: setup_script.sh:1201
msgid "❌ /etc/fstab already mounts %s at %s, not UUID=%s. Fix /etc/fstab or UUID in %s."
msgstr "❌ /etc/fstab monte déjà %s sur %s, et non UUID=%s. Corrigez /etc/fstab ou UUID dans %s."

#: setup_script.sh:1208
msgid "⚠️  /etc/fstab mounts this disk (UUID %s) at %s. It moves to %s:"
msgstr "⚠️  /etc/fstab monte ce disque (UUID %s) sur %s. Il sera déplacé vers %s :"

#: setup_script.sh:1209
msgid "   the backup service is stopped, the disk unmounted from the old place, the /etc/fstab line"
msgstr "   le service de sauvegarde est arrêté, le disque démonté de l'ancien emplacement, la ligne de /etc/fstab"

#: setup_script.sh:1210
msgid "   changed (old file kept as /etc/fstab.before-lnd-backups-move), and the disk mounted at the"
msgstr "   modifiée (ancien fichier gardé sous /etc/fstab.before-lnd-backups-move), et le disque monté au"

#: setup_script.sh:1211
msgid "   new place. The backups on it stay as they are."
msgstr "   nouvel emplacement. Les sauvegardes qu'il contient restent telles quelles."

#: setup_script.sh:1212
