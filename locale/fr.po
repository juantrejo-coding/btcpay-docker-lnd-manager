msgstr "elle ne contient pas backup_compressed.tar.gz et sa somme de contrôle"

#: lnd-wallet.sh:578
msgid "its checksum does not match (the file is damaged)"
msgstr "sa somme de contrôle ne correspond pas (le fichier est endommagé)"

