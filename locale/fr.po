msgid "it is not signed with the backup key %s"
msgstr "elle n'est pas signée avec la clé de sauvegarde %s"

#: lnd-wallet.sh:530
msgid "⚠️  The backup GPG key %s has expired. Backups signed with it are still good and are used, but"
msgstr "⚠️  La clé GPG des sauvegardes %s a expiré. Les sauvegardes signées avec elle restent bonnes et sont utilisées, mais"

#: lnd-wallet.sh:531
msgid "   the backup service can't make new ones. Remove the expiry (as root):"
msgstr "   le service de sauvegarde ne peut pas en faire de nouvelles. Retirez l'expiration (en root) :"

#: lnd-wallet.sh:532
msgid "   sudo -u %s gpg --homedir %s --quick-set-expire %s 0 '*'"
msgstr "   sudo -u %s gpg --homedir %s --quick-set-expire %s 0 '*'"

#: lnd-wallet.sh:533
msgid "   sudo -u %s gpg --homedir %s --quick-set-expire %s 0"
msgstr "   sudo -u %s gpg --homedir %s --quick-set-expire %s 0"

#: lnd-wallet.sh:534
msgid "   and save the key again where you keep it (its copy elsewhere still has the old date)."
msgstr "   et enregistrez à nouveau la clé là où vous la gardez (cette copie porte encore l'ancienne date)."

