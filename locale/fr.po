msgstr "%s %s : copie impossible"

#: lnd-wallet.sh:845
msgid "%s %s: %s"
msgstr "%s %s : %s"

#: lnd-wallet.sh:856
msgid "%s %s (%s)"
msgstr "%s %s (%s)"

#: lnd-wallet.sh:858
msgid ", a milestone: no regular backup could be used"
msgstr ", un jalon : aucune sauvegarde normale n'était utilisable"

#: lnd-wallet.sh:861
