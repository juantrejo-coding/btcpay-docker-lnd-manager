msgid "❌ Failed to set permissions on %s"
msgstr "❌ Impossible de définir les permissions de %s"

#: setup_script.sh:1313 setup_script.sh:1335
msgid "✅ Permissions for %s set."
msgstr "✅ Permissions de %s définies."

#: setup_script.sh:1316
msgid "ACL for SSH key removed."
msgstr "ACL de la clé SSH supprimée."

#: setup_script.sh:1319
msgid "Removing ACL for GPG private key at %s..."
msgstr "Suppression de l'ACL de la clé privée GPG dans %s..."

#: setup_script.sh:1321
msgid "ACL for GPG key removed."
msgstr "ACL de la clé GPG supprimée."

#: setup_script.sh:1324
msgid "Setting ownership and permissions for the GPG key directory..."
msgstr "Réglage du propriétaire et des permissions du dossier de clés GPG..."

#: setup_script.sh:1327
msgid "❌ Failed to set ownership on %s"
msgstr "❌ Impossible de définir le propriétaire de %s"

#: setup_script.sh:1329
msgid "✅ Ownership for %s set."
msgstr "✅ Propriétaire de %s défini."

#: setup_script.sh:1345
msgid "⚠️  %s is in the docker group, which amounts to root without a password: anything"
msgstr "⚠️  %s est dans le groupe docker, ce qui équivaut à root sans mot de passe : tout ce qui tourne"

#: setup_script.sh:1346
