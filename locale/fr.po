msgstr "Voulez-vous coller une clé privée GPG existante au format ASCII-armored ? (y/n) : "

#: setup_script.sh:916
msgid "🔐 Please paste your ASCII-armored GPG private key below."
msgstr "🔐 Collez ci-dessous votre clé privée GPG au format ASCII-armored."

#: setup_script.sh:917
