msgstr "❌ %s est un lien symbolique, n'appartient pas à root ou est modifiable par d'autres"

#: install-scripts.sh:100
msgid "❌ %s is %s, older than the installed %s (sudo lnd-update installed it)."
msgstr "❌ %s est en version %s, plus ancienne que la version %s installée (installée par sudo lnd-update)."

#: install-scripts.sh:101
msgid "   Move this folder to that release first: git fetch --tags && git checkout %s"
msgstr "   Passez d'abord ce dossier à cette version : git fetch --tags && git checkout %s"

#: install-scripts.sh:102
msgid "   (--force installs the older version anyway)"
msgstr "   (--force installe quand même la version plus ancienne)"

#: install-scripts.sh:215
msgid "✅ Installed into %s (changed: %s)"
msgstr "✅ Installé dans %s (modifié : %s)"

#: install-scripts.sh:217
