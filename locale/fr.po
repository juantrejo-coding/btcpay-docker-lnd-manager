msgstr "Voulez-vous générer une nouvelle clé GPG pour %s ? (y/n) : "

#: setup_script.sh:943
msgid "🛠️ Generating new GPG key..."
msgstr "🛠️ Génération d'une nouvelle clé GPG..."

#: setup_script.sh:955
msgid "✅ GPG key generated successfully."
msgstr "✅ Clé GPG générée avec succès."

#: setup_script.sh:963
