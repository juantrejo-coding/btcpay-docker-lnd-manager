msgid "✅ UUID %s is already in /etc/fstab at %s"
msgstr "✅ L'UUID %s est déjà dans /etc/fstab, sur %s"

#: setup_script.sh:1473
msgid "📝 Adding entry for UUID %s to /etc/fstab..."
