#: chain-tower.sh:70 lnd-wallet.sh:93
msgid "❌ Unknown option: %s"
msgstr "❌ Opción desconocida: %s"

#: chain-tower.sh:75
msgid "❌ chain-tower.sh needs a terminal for its confirmations."
msgstr "❌ chain-tower.sh necesita una terminal para sus confirmaciones."

#: chain-tower.sh:122
msgid "ℹ️ A chain/tower operation is already running in tmux session '%s'. Attaching to it..."
msgstr "ℹ️ Ya hay una operación de blockchain/torre en curso en la sesión de tmux '%s'. Conectándose a ella..."

#: chain-tower.sh:124
msgid "ℹ️ That was the earlier operation; this one (%s) was not started."
msgstr "ℹ️ Esa era la operación anterior; esta (%s) no se inició."

#: chain-tower.sh:136
msgid "ℹ️ It is still running in tmux. Back to it: run the same command again."
msgstr "ℹ️ Sigue en curso en tmux. Para volver a ella, ejecute de nuevo el mismo comando."

#: chain-tower.sh:139 lnd-wallet.sh:168
msgid "⚠️ tmux could not start a session. Continuing without it: don't let the SSH connection drop."
msgstr "⚠️ tmux no pudo iniciar una sesión. Se continúa sin él: no deje que se corte la conexión SSH."

#: chain-tower.sh:146 lnd-wallet.sh:179
msgid "Finished (exit code %s). Press Enter to close this tmux session. "
msgstr "Terminado (código de salida %s). Presione Enter para cerrar esta sesión de tmux. "

#: chain-tower.sh:149 lnd-wallet.sh:182
msgid "Finished (exit code %s). Press Enter to go back. "
msgstr "Terminado (código de salida %s). Presione Enter para volver. "

#: chain-tower.sh:155
msgid "Another chain-tower.sh is running. Let it finish first."
msgstr "Ya hay otro chain-tower.sh en ejecución. Espere a que termine."

#: chain-tower.sh:159
msgid "lnd-wallet.sh is running. Let it finish first."
msgstr "lnd-wallet.sh está en ejecución. Espere a que termine."

#: chain-tower.sh:163
msgid "BTCPay isn't installed the usual way (%s, %s)"
msgstr "BTCPay no está instalado de la forma habitual (%s, %s)"

#: chain-tower.sh:172
msgid "⚙️ btcpay-setup.sh with BTCPAYGEN_ADDITIONAL_FRAGMENTS=\"%s\" (BTCPay restarts)..."
msgstr "⚙️ btcpay-setup.sh con BTCPAYGEN_ADDITIONAL_FRAGMENTS=\"%s\" (BTCPay se reinicia)..."

#: chain-tower.sh:179
msgid "btcpay-setup.sh failed (exit code %s); see the lines above. Check BTCPay: %s/btcpay-up.sh"
msgstr "btcpay-setup.sh falló (código de salida %s); vea las líneas de arriba. Revise BTCPay: %s/btcpay-up.sh"

#: chain-tower.sh:180
msgid "btcpay-setup.sh didn't take the new fragments; see the lines above"
msgstr "btcpay-setup.sh no aplicó los nuevos fragmentos; vea las líneas de arriba"

#: chain-tower.sh:181
msgid "✅ BTCPay runs with: %s"
msgstr "✅ BTCPay funciona con: %s"

#: chain-tower.sh:199
msgid "⚠️  BTCPay will be stopped: the store can't take payments and Lightning is offline for %s."
msgstr "⚠️  Se detendrá BTCPay: la tienda no podrá recibir pagos y Lightning estará fuera de línea durante %s."

#: chain-tower.sh:200 lnd-wallet.sh:1107
msgid "Type 'STOP BTCPAY' to stop it: "
msgstr "Escriba 'STOP BTCPAY' para detenerlo: "

#: chain-tower.sh:201
msgid "Aborted: BTCPay was not stopped and nothing was changed."
msgstr "Cancelado: BTCPay no se detuvo y no se cambió nada."

#: chain-tower.sh:223
msgid "BTCPay's blockchain: %s of blocks, prune=%s"
msgstr "Blockchain de BTCPay: %s de bloques, prune=%s"

#: chain-tower.sh:224
msgid "Fragments now: %s"
msgstr "Fragmentos actuales: %s"

#: chain-tower.sh:226
msgid "BTCPay's pruning presets keep this much of the blockchain:"
msgstr "Los ajustes de poda predefinidos de BTCPay conservan esta parte de la blockchain:"

#: chain-tower.sh:227
msgid "  1) opt-save-storage       ~100 GB"
msgstr "  1) opt-save-storage       ~100 GB"

#: chain-tower.sh:228
msgid "  2) opt-save-storage-s     ~50 GB"
msgstr "  2) opt-save-storage-s     ~50 GB"

#: chain-tower.sh:229
msgid "  3) opt-save-storage-xs    ~25 GB   recommended: keeps about 3 months of blocks"
msgstr "  3) opt-save-storage-xs    ~25 GB   recomendado: conserva unos 3 meses de bloques"

#: chain-tower.sh:230
msgid "  4) opt-save-storage-xxs   ~5 GB    BTCPay warns that Lightning can have trouble with this little"
msgstr "  4) opt-save-storage-xxs   ~5 GB    BTCPay advierte que Lightning puede tener problemas con tan poco"

#: chain-tower.sh:231
msgid "Pruning deletes old blocks: BTCPay can then no longer rescan for transactions older than what it"
msgstr "La poda borra bloques antiguos: luego BTCPay ya no puede volver a buscar transacciones anteriores a"

#: chain-tower.sh:232
msgid "keeps (for example when importing an old wallet). Do it only if you have no old transactions to"
msgstr "lo que conserva (por ejemplo, al importar una billetera antigua). Hágalo solo si no tiene transacciones"

#: chain-tower.sh:233
msgid "find. Lightning needs blocks back to its oldest channel's opening."
msgstr "antiguas que buscar. Lightning necesita los bloques desde la apertura de su canal más antiguo."

#: chain-tower.sh:235
msgid "Choose 1-4 (Enter for 3, q to stop): "
msgstr "Elija 1-4 (Enter = 3, q = salir): "

#: chain-tower.sh:241 lnd-wallet.sh:821 lnd-wallet.sh:1806
#: serverb/serverb-dashboard-setup.sh:52 serverb/serverb-import-chain.sh:41
#: serverb/serverb-user-setup.sh:85 serverb/serverb-user-setup.sh:91
msgid "Stopped: nothing was changed."
msgstr "Detenido: no se cambió nada."

#: chain-tower.sh:247
msgid "ℹ️ BTCPay already uses %s"
msgstr "ℹ️ BTCPay ya usa %s"

#: chain-tower.sh:248
msgid "a few minutes, while btcpay-setup.sh applies %s"
msgstr "unos minutos, mientras btcpay-setup.sh aplica %s"

#: chain-tower.sh:250
msgid "✅ BTCPay's blockchain is pruned to %s; bitcoind deletes old blocks as it starts."
msgstr "✅ La blockchain de BTCPay queda podada con %s; bitcoind borra los bloques antiguos al iniciar."

#: chain-tower.sh:325
msgid "Could not find BTCPay's bitcoind container (%s)"
msgstr "No se encontró el contenedor de bitcoind de BTCPay (%s)"

#: chain-tower.sh:330
msgid "Could not start the bitcoind that prunes the copy"
msgstr "No se pudo iniciar el bitcoind que poda la copia"

#: chain-tower.sh:337
msgid "The bitcoind that prunes the copy didn't answer"
msgstr "El bitcoind que poda la copia no respondió"

#: chain-tower.sh:343
msgid "✂️ Pruning the copy: blocks up to %s go, the newest %s stay (of %s)..."
msgstr "✂️ Podando la copia: se eliminan los bloques hasta el %s y se quedan los %s más recientes (de %s)..."

#: chain-tower.sh:345
msgid "Pruning the copy failed"
msgstr "La poda de la copia falló"

#: chain-tower.sh:361
msgid "SERVER_B_USER or REMOTE_SERVER is empty in config. Run setup first."
msgstr "SERVER_B_USER o REMOTE_SERVER está vacío en config. Ejecute primero la configuración."

#: chain-tower.sh:362
msgid "No blockchain in %s (BITCOIND_DIR in config)"
msgstr "No hay blockchain en %s (BITCOIND_DIR en config)"

#: chain-tower.sh:369
msgid "There is no user %s (SERVER_A_USER in config)"
msgstr "No existe el usuario %s (SERVER_A_USER en config)"

#: chain-tower.sh:373
msgid "Server B's backup gate doesn't answer. Run setup first (lnd-manager: /setup)."
msgstr "La compuerta de copias del Servidor B no responde. Ejecute primero la configuración (lnd-manager: /setup)."

#: chain-tower.sh:376
msgid "Server B's backup gate is older and can't say how much space it has: update it there first (step 1 of serverb-setup.sh, or /update scripts)"
msgstr "La compuerta de copias del Servidor B es más antigua y no puede indicar cuánto espacio tiene: actualícela allí primero (paso 1 de serverb-setup.sh, o /update scripts)"

#: chain-tower.sh:379
msgid "Server B has no ~%s/chain-incoming: serverb-bitcoind-setup.sh makes it when you choose to copy the blockchain there"
msgstr "El Servidor B no tiene ~%s/chain-incoming: serverb-bitcoind-setup.sh lo crea cuando usted elige copiar allí la blockchain"

#: chain-tower.sh:392
msgid "BTCPay's blockchain: %s GB (prune=%s), of which the chainstate (which can't be pruned) is %s GB."
msgstr "Blockchain de BTCPay: %s GB (prune=%s), de los cuales el chainstate (que no se puede podar) ocupa %s GB."

#: chain-tower.sh:395
msgid "⚠️  It isn't pruned: all of it would be copied (hundreds of GB). Prune it first: /chain prune."
msgstr "⚠️  No está podada: se copiaría completa (cientos de GB). Pódela primero: /chain prune."

#: chain-tower.sh:396 chain-tower.sh:405 chain-tower.sh:461
msgid "Stopped: nothing was copied."
msgstr "Detenido: no se copió nada."

#: chain-tower.sh:396
msgid "Type 'COPY ALL' to copy it unpruned anyway: "
msgstr "Escriba 'COPY ALL' para copiarla sin podar de todos modos: "

#: chain-tower.sh:399
msgid "Where should the blockchain be pruned to Server B's size (%s MB) for the watchtower?"
msgstr "¿Dónde se debe podar la blockchain al tamaño del Servidor B (%s MB) para la watchtower?"

#: chain-tower.sh:400
msgid "  1. On Server A: a pruned copy is made beside BTCPay's, and only that is sent (about %s GB)."
msgstr "  1. En el Servidor A: se crea una copia podada junto a la de BTCPay y solo se envía esa (unos %s GB)."

#: chain-tower.sh:401
msgid "     BTCPay's own blockchain isn't changed. Needs about %s GB free here meanwhile."
msgstr "     La blockchain propia de BTCPay no cambia. Necesita unos %s GB libres aquí mientras tanto."

#: chain-tower.sh:402
msgid "  2. On Server B: BTCPay's whole pruned blockchain is sent (%s GB), and Server B prunes it"
msgstr "  2. En el Servidor B: se envía toda la blockchain podada de BTCPay (%s GB) y el Servidor B la poda"

#: chain-tower.sh:403
msgid "     after the import. Nothing extra on this server; more to send, more room on Server B."
msgstr "     tras la importación. Nada extra en este servidor; más que enviar y más espacio en el Servidor B."

#: chain-tower.sh:405 serverb-scripts.sh:209 setup_script.sh:833
msgid "Choose 1 or 2: "
msgstr "Elija 1 o 2: "

#: chain-tower.sh:423
msgid "❌ Not enough space on Server A for the pruned copy: %s GB needed in %s, %s GB free."
msgstr "❌ No hay espacio suficiente en el Servidor A para la copia podada: se necesitan %s GB en %s, hay %s GB libres."

#: chain-tower.sh:425
msgid "   Free some space, or choose 2 (pruned on Server B)."
msgstr "   Libere espacio o elija 2 (podada en el Servidor B)."

#: chain-tower.sh:437
msgid "❌ Not enough space on Server B: the copy needs %s GB in ~%s (with 5 GB kept free), %s GB free there."
msgstr "❌ No hay espacio suficiente en el Servidor B: la copia necesita %s GB en ~%s (dejando 5 GB libres), allí hay %s GB libres."

#: chain-tower.sh:439
msgid "   The import moves it to /var/lib, another disk there: %s GB needed, %s GB free."
msgstr "   La importación la mueve a /var/lib, que allí es otro disco: se necesitan %s GB, hay %s GB libres."

#: chain-tower.sh:441
msgid "   Choose 1 (pruned on Server A) to send less, or free space on Server B."
msgstr "   Elija 1 (podada en el Servidor A) para enviar menos, o libere espacio en el Servidor B."

#: chain-tower.sh:445
msgid "✅ Room enough: Server B has %s GB free for %s GB."
msgstr "✅ Espacio suficiente: el Servidor B tiene %s GB libres para %s GB."

#: chain-tower.sh:448 chain-tower.sh:453
msgid "Two passes, so BTCPay is down only for the second:"
msgstr "Dos pasadas, para que BTCPay esté detenido solo durante la segunda:"

#: chain-tower.sh:449
msgid "  1. while BTCPay runs: the pruned copy is made here (the chainstate copied, about %s GB)."
msgstr "  1. con BTCPay en marcha: se crea aquí la copia podada (se copia el chainstate, unos %s GB)."

#: chain-tower.sh:450 chain-tower.sh:456
msgid "  2. BTCPay stopped (you type STOP BTCPAY): only what changed meanwhile, usually minutes."
msgstr "  2. con BTCPay detenido (usted escribe STOP BTCPAY): solo lo que cambió entretanto, unos minutos."

#: chain-tower.sh:451
msgid "     Then BTCPay starts again, the copy is pruned and sent to Server B, and deleted here."
msgstr "     Luego BTCPay se inicia de nuevo, la copia se poda, se envía al Servidor B y se borra aquí."

#: chain-tower.sh:454
msgid "  1. while BTCPay runs: almost everything (%s GB). This can take hours; BTCPay keeps working."
msgstr "  1. con BTCPay en marcha: casi todo (%s GB). Puede tardar horas; BTCPay sigue funcionando."

#: chain-tower.sh:455
msgid "     If the connection drops, run /chain copy again: it goes on where it stopped."
msgstr "     Si se corta la conexión, ejecute /chain copy de nuevo: continúa donde se quedó."

#: chain-tower.sh:457
msgid "     Then BTCPay starts again."
msgstr "     Luego BTCPay se inicia de nuevo."

#: chain-tower.sh:459
msgid "Server B's gate takes it only into ~%s/chain-incoming (serverb-bitcoind-setup.sh makes it)."
msgstr "La compuerta del Servidor B solo la acepta en ~%s/chain-incoming (la crea serverb-bitcoind-setup.sh)."

#: chain-tower.sh:460
msgid "Afterwards, on Server B: sudo bash serverb-import-chain.sh"
msgstr "Después, en el Servidor B: sudo bash serverb-import-chain.sh"

#: chain-tower.sh:461
msgid "Start the copy? Type yes: "
msgstr "¿Iniciar la copia? Escriba yes: "

#: chain-tower.sh:471
msgid "📦 Pass 1 of 2: making the pruned copy in %s while BTCPay runs..."
msgstr "📦 Pasada 1 de 2: creando la copia podada en %s con BTCPay en marcha..."

#: chain-tower.sh:474
msgid "Making the copy failed, so BTCPay was not stopped. Free space in %s, then run /chain copy again."
msgstr "La creación de la copia falló, así que BTCPay no se detuvo. Libere espacio en %s y ejecute /chain copy de nuevo."

#: chain-tower.sh:477
msgid "📤 Pass 1 of 2: copying while BTCPay runs..."
msgstr "📤 Pasada 1 de 2: copiando con BTCPay en marcha..."

#: chain-tower.sh:483
msgid "⚠️ Pass 1 ended with code %s (files changing while BTCPay runs, expected). Going on to pass 2, which copies the rest."
msgstr "⚠️ La pasada 1 terminó con código %s (archivos que cambian con BTCPay en marcha, es lo esperado). Se sigue con la pasada 2, que copia el resto."

#: chain-tower.sh:484
msgid "Pass 1 failed (rsync exit code %s), so BTCPay was not stopped. Fix what the lines above say, then run /chain copy again."
msgstr "La pasada 1 falló (código de salida de rsync %s), así que BTCPay no se detuvo. Corrija lo que indican las líneas de arriba y ejecute /chain copy de nuevo."

#: chain-tower.sh:487
msgid "a few minutes, while the rest of the blockchain is copied"
msgstr "unos minutos, mientras se copia el resto de la blockchain"

#: chain-tower.sh:490
msgid "🛑 Stopping BTCPay (btcpay-down.sh)..."
msgstr "🛑 Deteniendo BTCPay (btcpay-down.sh)..."

#: chain-tower.sh:491
msgid "btcpay-down.sh failed"
msgstr "btcpay-down.sh falló"

#: chain-tower.sh:493
msgid "📦 Pass 2 of 2: the rest, with BTCPay stopped..."
msgstr "📦 Pasada 2 de 2: el resto, con BTCPay detenido..."

#: chain-tower.sh:494
msgid "Making the copy failed. BTCPay is started again; run /chain copy again later."
msgstr "La creación de la copia falló. BTCPay se inicia de nuevo; ejecute /chain copy de nuevo más tarde."

#: chain-tower.sh:495
msgid "🚀 Starting BTCPay again..."
msgstr "🚀 Iniciando BTCPay de nuevo..."

#: chain-tower.sh:496
msgid "❌ btcpay-up.sh failed: run %s/btcpay-up.sh by hand"
msgstr "❌ btcpay-up.sh falló: ejecute %s/btcpay-up.sh a mano"

#: chain-tower.sh:500
msgid "📤 Sending the pruned copy (%s GB) to Server B..."
msgstr "📤 Enviando la copia podada (%s GB) al Servidor B..."

#: chain-tower.sh:501
msgid "Sending the copy failed. Run /chain copy again later (BTCPay keeps running)."
msgstr "El envío de la copia falló. Ejecute /chain copy de nuevo más tarde (BTCPay sigue en marcha)."

#: chain-tower.sh:503
msgid "📤 Pass 2 of 2: copying the rest with BTCPay stopped..."
msgstr "📤 Pasada 2 de 2: copiando el resto con BTCPay detenido..."

#: chain-tower.sh:504
msgid "Pass 2 failed. BTCPay is started again; run /chain copy again later."
msgstr "La pasada 2 falló. BTCPay se inicia de nuevo; ejecute /chain copy otra vez más tarde."

#: chain-tower.sh:506
msgid "✅ Blockchain copied to Server B. Next, on Server B: sudo bash serverb-import-chain.sh"
msgstr "✅ Blockchain copiada al Servidor B. Ahora, en el Servidor B: sudo bash serverb-import-chain.sh"

#: chain-tower.sh:511
msgid "WATCHTOWER_PUBKEY in config isn't a public key (66 hex characters)"
msgstr "WATCHTOWER_PUBKEY en config no es una clave pública (66 caracteres hexadecimales)"

#: chain-tower.sh:512
msgid "WATCHTOWER_IP in config isn't set"
msgstr "WATCHTOWER_IP no está definido en config"

#: chain-tower.sh:513
msgid "WATCHTOWER_PORT in config isn't a port"
msgstr "WATCHTOWER_PORT en config no es un puerto"

#: chain-tower.sh:517
msgid "BTCPay's LND has its watchtower client off. BTCPay's opt-lnd-wtclient fragment turns it on"
msgstr "El LND de BTCPay tiene el cliente de watchtower desactivado. El fragmento opt-lnd-wtclient de BTCPay"

#: chain-tower.sh:518
msgid "(wtclient.active=1); btcpay-setup.sh applies it and restarts LND."
msgstr "lo activa (wtclient.active=1); btcpay-setup.sh lo aplica y reinicia LND."

#: chain-tower.sh:519
msgid "a few minutes, while btcpay-setup.sh turns on the watchtower client"
msgstr "unos minutos, mientras btcpay-setup.sh activa el cliente de watchtower"

#: chain-tower.sh:523
msgid "⏳ Waiting for LND..."
msgstr "⏳ Esperando a LND..."

#: chain-tower.sh:524
msgid "LND doesn't answer (docker logs %s)"
msgstr "LND no responde (docker logs %s)"

#: chain-tower.sh:527
msgid "⏳ LND is still catching up with the chain; the watchtower client waits for that (up to 10 minutes here)..."
msgstr "⏳ LND aún se sincroniza con la blockchain; el cliente de watchtower lo espera (aquí hasta 10 minutos)..."

#: chain-tower.sh:529
msgid "➕ Adding the watchtower %s..."
msgstr "➕ Agregando la watchtower %s..."

#: chain-tower.sh:537
msgid "LND's watchtower client didn't answer within 10 minutes (LND not synced to the chain yet?). The client is on; run /tower add again later."
msgstr "El cliente de watchtower de LND no respondió en 10 minutos (¿LND aún no está sincronizado con la blockchain?). El cliente está activado; ejecute /tower add de nuevo más tarde."

#: chain-tower.sh:538
msgid "lncli wtclient add failed"
msgstr "lncli wtclient add falló"

#: chain-tower.sh:540
msgid "✅ The watchtower is added. LND sends it encrypted channel updates from now on."
msgstr "✅ La watchtower está agregada. Desde ahora LND le envía actualizaciones cifradas de los canales."

#: chain-tower.sh:548
msgid "The watchtower client isn't on, LND isn't running, or LND is still catching up with the chain:"
msgstr "El cliente de watchtower está desactivado, LND no está en ejecución o aún se sincroniza con la blockchain:"

#: chain-tower.sh:552
msgid "Towers:"
msgstr "Torres:"

#: chain-tower.sh:554
msgid "Statistics:"
msgstr "Estadísticas:"

#: config-lib.sh:17
msgid "❌ %s can't hold \", $, `, \\ or control characters: %s"
msgstr "❌ %s no puede contener \", $, `, \\ ni caracteres de control: %s"

#: config-lib.sh:21 config-lib.sh:46
msgid "❌ Expected exactly one %s= line in %s"
msgstr "❌ Se esperaba exactamente una línea %s= en %s"

#: config-lib.sh:29
msgid "❌ Could not write %s (the original is saved in %s)"
msgstr "❌ No se pudo escribir %s (el original está guardado en %s)"

#: config-lib.sh:35
msgid "❌ Failed to reload %s with %s=\"%s\""
msgstr "❌ No se pudo volver a cargar %s con %s=\"%s\""

#: config-lib.sh:38
msgid "✅ Saved %s=\"%s\" in %s"
msgstr "✅ Se guardó %s=\"%s\" en %s"

#: config-lib.sh:65 rsync_gpg_backup.sh:321
msgid "❌ Not allowed: %s"
msgstr "❌ No permitido: %s"

#: config-lib.sh:74
msgid "❌ %s in config is not allowed: %s"
msgstr "❌ El valor de %s en config no está permitido: %s"

#: config-lib.sh:83
msgid "enter a hostname or IP address (letters, digits, '.', ':' and '-', no user@ or spaces)"
msgstr "ingrese un nombre de host o una dirección IP (letras, dígitos, '.', ':' y '-', sin user@ ni espacios)"

#: config-lib.sh:91 serverb-lib.sh:37
msgid "use up to 32 lowercase letters, digits, _ or -, starting with a letter"
msgstr "use hasta 32 letras minúsculas, dígitos, _ o -, comenzando con una letra"

#: config-lib.sh:93
msgid "use an account of its own on Server B, not root, bitcoin or lndtower"
msgstr "use una cuenta propia en el Servidor B, no root, bitcoin ni lndtower"

#: config-lib.sh:100
msgid "enter a port number from 1 to 65535"
msgstr "ingrese un número de puerto del 1 al 65535"

#: config-lib.sh:195
msgid "❌ Could not add the new settings to %s"
msgstr "❌ No se pudieron agregar los nuevos ajustes a %s"

#: config-lib.sh:201
msgid "❌ Failed to reload %s after adding new settings"
msgstr "❌ No se pudo volver a cargar %s después de agregar los nuevos ajustes"

#: config-lib.sh:204
msgid "✅ Updated %s: %s"
msgstr "✅ Se actualizó %s: %s"

#: destinations.sh
msgid "Cancelled: nothing was changed."
msgstr "Cancelado: no se cambió nada."

#: destinations.sh
msgid "❌ install-scripts.sh failed"
msgstr "❌ install-scripts.sh falló"

#: destinations.sh:46 rsync_gpg_backup.sh:75
msgid "the attached volume (%s)"
msgstr "el volumen adjunto (%s)"

#: destinations.sh:47 rsync_gpg_backup.sh:76
msgid "Server B (%s)"
msgstr "el Servidor B (%s)"

#: destinations.sh:48 rsync_gpg_backup.sh:77
msgid "GitHub (%s)"
msgstr "GitHub (%s)"

#: destinations.sh:70
msgid "never"
msgstr "nunca"

#: destinations.sh:76
msgid "Where the backups go:"
msgstr "Adónde van las copias de seguridad:"

#: destinations.sh:80
msgid "  ✅ on   %s, last copy: %s"
msgstr "  ✅ activado     %s, última copia: %s"

#: destinations.sh:82
msgid "  ➖ off  %s"
msgstr "  ➖ desactivado  %s"

#: destinations.sh:86
msgid "⚠️  No copy leaves this server: if it is lost, the backups are lost with it."
msgstr "⚠️  Ninguna copia sale de este servidor: si se pierde, las copias de seguridad se pierden con él."

#: destinations.sh:94
msgid "❌ Unknown destination: %s (volume, serverb or github)"
msgstr "❌ Destino desconocido: %s (volume, serverb o github)"

#: destinations.sh:97
