msgstr "⏳ No es seguro actualizar ahora: %s"

#: lnd-update.sh:243
msgid "   It waits in the background (lnd-update-wait) and installs %s once it is safe, for up to"
msgstr "   Espera en segundo plano (lnd-update-wait) e instala %s en cuanto sea seguro, durante un máximo de"

