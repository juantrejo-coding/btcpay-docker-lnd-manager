msgstr "⚠️ El contenedor de LND '%s' está detenido. Iniciando BTCPay para leer la billetera actual..."

#: lnd-wallet.sh:962
msgid "⚠️ btcpay-up.sh failed"
msgstr "⚠️ btcpay-up.sh falló"

#: lnd-wallet.sh:965
msgid "⏳ Waiting for the current LND to answer (up to 3 minutes)..."
msgstr "⏳ Esperando a que responda el LND actual (hasta 3 minutos)..."

#: lnd-wallet.sh:971
msgid "Couldn't read the current wallet: LND isn't answering (state: %s)."
msgstr "No se pudo leer la billetera actual: LND no responde (estado: %s)."

#: lnd-wallet.sh:987
msgid "Node ID:           %s"
msgstr "ID del nodo:       %s"

#: lnd-wallet.sh:988
msgid "On-chain:          %s sat confirmed, %s sat unconfirmed"
msgstr "On-chain:          %s sat confirmados, %s sat sin confirmar"

#: lnd-wallet.sh:989
msgid "Open channels:     %s (your share: %s sat)"
msgstr "Canales abiertos:  %s (su parte: %s sat)"

#: lnd-wallet.sh:990
