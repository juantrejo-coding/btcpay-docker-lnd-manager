#: chain-tower.sh:70 lnd-wallet.sh:93
msgid "❌ Unknown option: %s"
msgstr "❌ Unbekannte Option: %s"

#: chain-tower.sh:75
msgid "❌ chain-tower.sh needs a terminal for its confirmations."
msgstr "❌ chain-tower.sh braucht ein Terminal für seine Bestätigungen."

#: chain-tower.sh:122
msgid "ℹ️ A chain/tower operation is already running in tmux session '%s'. Attaching to it..."
msgstr "ℹ️ In der tmux-Sitzung '%s' läuft bereits ein Blockchain-/Tower-Vorgang. Verbindung dorthin..."

#: chain-tower.sh:124
msgid "ℹ️ That was the earlier operation; this one (%s) was not started."
msgstr "ℹ️ Das war der frühere Vorgang; dieser (%s) wurde nicht gestartet."

#: chain-tower.sh:136
msgid "ℹ️ It is still running in tmux. Back to it: run the same command again."
msgstr "ℹ️ Er läuft in tmux weiter. Zurück dorthin: Führen Sie denselben Befehl erneut aus."

#: chain-tower.sh:139 lnd-wallet.sh:168
msgid "⚠️ tmux could not start a session. Continuing without it: don't let the SSH connection drop."
msgstr "⚠️ tmux konnte keine Sitzung starten. Weiter ohne tmux: Lassen Sie die SSH-Verbindung nicht abbrechen."

#: chain-tower.sh:146 lnd-wallet.sh:179
msgid "Finished (exit code %s). Press Enter to close this tmux session. "
msgstr "Fertig (Exit-Code %s). Drücken Sie Enter, um diese tmux-Sitzung zu schließen. "

#: chain-tower.sh:149 lnd-wallet.sh:182
msgid "Finished (exit code %s). Press Enter to go back. "
msgstr "Fertig (Exit-Code %s). Drücken Sie Enter, um zurückzugehen. "

#: chain-tower.sh:155
msgid "Another chain-tower.sh is running. Let it finish first."
msgstr "Ein anderes chain-tower.sh läuft. Warten Sie, bis es fertig ist."

#: chain-tower.sh:159
msgid "lnd-wallet.sh is running. Let it finish first."
msgstr "lnd-wallet.sh läuft. Warten Sie, bis es fertig ist."

#: chain-tower.sh:163
msgid "BTCPay isn't installed the usual way (%s, %s)"
msgstr "BTCPay ist nicht auf die übliche Weise installiert (%s, %s)"

#: chain-tower.sh:172
msgid "⚙️ btcpay-setup.sh with BTCPAYGEN_ADDITIONAL_FRAGMENTS=\"%s\" (BTCPay restarts)..."
msgstr "⚙️ btcpay-setup.sh mit BTCPAYGEN_ADDITIONAL_FRAGMENTS=\"%s\" (BTCPay startet neu)..."

#: chain-tower.sh:179
msgid "btcpay-setup.sh failed (exit code %s); see the lines above. Check BTCPay: %s/btcpay-up.sh"
msgstr "btcpay-setup.sh fehlgeschlagen (Exit-Code %s); siehe die Zeilen oben. Prüfen Sie BTCPay: %s/btcpay-up.sh"

#: chain-tower.sh:180
msgid "btcpay-setup.sh didn't take the new fragments; see the lines above"
msgstr "btcpay-setup.sh hat die neuen Fragmente nicht übernommen; siehe die Zeilen oben"

#: chain-tower.sh:181
msgid "✅ BTCPay runs with: %s"
msgstr "✅ BTCPay läuft mit: %s"

#: chain-tower.sh:199
msgid "⚠️  BTCPay will be stopped: the store can't take payments and Lightning is offline for %s."
msgstr "⚠️  BTCPay wird gestoppt: Der Store kann keine Zahlungen annehmen und Lightning ist offline für %s."

#: chain-tower.sh:200 lnd-wallet.sh:901
msgid "Type 'STOP BTCPAY' to stop it: "
msgstr "Geben Sie 'STOP BTCPAY' ein, um BTCPay zu stoppen: "

#: chain-tower.sh:201
msgid "Aborted: BTCPay was not stopped and nothing was changed."
msgstr "Abgebrochen: BTCPay wurde nicht gestoppt und nichts wurde geändert."

#: chain-tower.sh:223
msgid "BTCPay's blockchain: %s of blocks, prune=%s"
msgstr "Blockchain von BTCPay: %s an Blöcken, prune=%s"

#: chain-tower.sh:224
msgid "Fragments now: %s"
msgstr "Aktuelle Fragmente: %s"

#: chain-tower.sh:226
msgid "BTCPay's pruning presets keep this much of the blockchain:"
msgstr "Die Pruning-Presets von BTCPay behalten so viel von der Blockchain:"

#: chain-tower.sh:227
msgid "  1) opt-save-storage       ~100 GB"
msgstr "  1) opt-save-storage       ~100 GB"

#: chain-tower.sh:228
msgid "  2) opt-save-storage-s     ~50 GB"
msgstr "  2) opt-save-storage-s     ~50 GB"

#: chain-tower.sh:229
msgid "  3) opt-save-storage-xs    ~25 GB   recommended: keeps about 3 months of blocks"
msgstr "  3) opt-save-storage-xs    ~25 GB   empfohlen: behält etwa 3 Monate an Blöcken"

#: chain-tower.sh:230
msgid "  4) opt-save-storage-xxs   ~5 GB    BTCPay warns that Lightning can have trouble with this little"
msgstr "  4) opt-save-storage-xxs   ~5 GB    laut BTCPay kann Lightning mit so wenig Probleme bekommen"

#: chain-tower.sh:231
msgid "Pruning deletes old blocks: BTCPay can then no longer rescan for transactions older than what it"
msgstr "Pruning löscht alte Blöcke: BTCPay findet danach per Rescan keine Transaktionen mehr, die älter sind"

#: chain-tower.sh:232
msgid "keeps (for example when importing an old wallet). Do it only if you have no old transactions to"
msgstr "als das, was es behält (z. B. beim Import einer alten Wallet). Tun Sie es nur, wenn Sie keine alten"

#: chain-tower.sh:233
msgid "find. Lightning needs blocks back to its oldest channel's opening."
msgstr "Transaktionen suchen müssen. Lightning braucht die Blöcke ab der Eröffnung seines ältesten Kanals."

#: chain-tower.sh:235
msgid "Choose 1-4 (Enter for 3, q to stop): "
msgstr "Wählen Sie 1-4 (Enter für 3, q zum Abbrechen): "

#: chain-tower.sh:241 serverb/serverb-dashboard-setup.sh:52
#: serverb/serverb-import-chain.sh:41 serverb/serverb-user-setup.sh:85
#: serverb/serverb-user-setup.sh:91
msgid "Stopped: nothing was changed."
msgstr "Abgebrochen: Es wurde nichts geändert."

#: chain-tower.sh:247
msgid "ℹ️ BTCPay already uses %s"
msgstr "ℹ️ BTCPay verwendet bereits %s"

#: chain-tower.sh:248
msgid "a few minutes, while btcpay-setup.sh applies %s"
msgstr "einige Minuten, während btcpay-setup.sh %s anwendet"

#: chain-tower.sh:250
msgid "✅ BTCPay's blockchain is pruned to %s; bitcoind deletes old blocks as it starts."
msgstr "✅ Die Blockchain von BTCPay ist jetzt mit %s gepruned; bitcoind löscht alte Blöcke beim Start."

#: chain-tower.sh:308
msgid "Could not find BTCPay's bitcoind container (%s)"
msgstr "Der bitcoind-Container von BTCPay wurde nicht gefunden (%s)"

#: chain-tower.sh:313
msgid "Could not start the bitcoind that prunes the copy"
msgstr "Der bitcoind, der die Kopie prunt, ließ sich nicht starten"

#: chain-tower.sh:320
msgid "The bitcoind that prunes the copy didn't answer"
msgstr "Der bitcoind, der die Kopie prunt, hat nicht geantwortet"

#: chain-tower.sh:326
msgid "✂️ Pruning the copy: blocks up to %s go, the newest %s stay (of %s)..."
msgstr "✂️ Die Kopie wird gepruned: Blöcke bis %s werden gelöscht, die neuesten %s bleiben (von %s)..."

#: chain-tower.sh:328
msgid "Pruning the copy failed"
msgstr "Pruning der Kopie fehlgeschlagen"

#: chain-tower.sh:344
msgid "SERVER_B_USER or REMOTE_SERVER is empty in config. Run setup first."
msgstr "SERVER_B_USER oder REMOTE_SERVER ist in config leer. Führen Sie zuerst das Setup aus."

#: chain-tower.sh:345
msgid "No blockchain in %s (BITCOIND_DIR in config)"
msgstr "Keine Blockchain in %s (BITCOIND_DIR in config)"

#: chain-tower.sh:352
msgid "There is no user %s (SERVER_A_USER in config)"
msgstr "Es gibt keinen Benutzer %s (SERVER_A_USER in config)"

#: chain-tower.sh:355
msgid "Server B's backup gate doesn't answer. Run setup first (lnd-manager: /setup)."
msgstr "Das Backup-Gate von Server B antwortet nicht. Führen Sie zuerst das Setup aus (lnd-manager: /setup)."

#: chain-tower.sh:358
msgid "Server B's backup gate is older and can't say how much space it has: update it there first (step 1 of serverb-setup.sh, or /update scripts)"
msgstr "Das Backup-Gate von Server B ist älter und kann nicht sagen, wie viel Platz es hat: Aktualisieren Sie es zuerst dort (Schritt 1 von serverb-setup.sh oder /update scripts)"

#: chain-tower.sh:361
msgid "Server B has no ~%s/chain-incoming: serverb-bitcoind-setup.sh makes it when you choose to copy the blockchain there"
msgstr "Server B hat kein ~%s/chain-incoming: serverb-bitcoind-setup.sh legt es an, wenn Sie dort wählen, die Blockchain zu kopieren"

#: chain-tower.sh:374
msgid "BTCPay's blockchain: %s GB (prune=%s), of which the chainstate (which can't be pruned) is %s GB."
msgstr "Blockchain von BTCPay: %s GB (prune=%s), davon ist der Chainstate (der sich nicht prunen lässt) %s GB."

#: chain-tower.sh:377
msgid "⚠️  It isn't pruned: all of it would be copied (hundreds of GB). Prune it first: /chain prune."
msgstr "⚠️  Sie ist nicht gepruned: Alles würde kopiert (Hunderte GB). Prunen Sie sie zuerst: /chain prune."

#: chain-tower.sh:378 chain-tower.sh:387 chain-tower.sh:443
msgid "Stopped: nothing was copied."
msgstr "Abgebrochen: Es wurde nichts kopiert."

#: chain-tower.sh:378
msgid "Type 'COPY ALL' to copy it unpruned anyway: "
msgstr "Geben Sie 'COPY ALL' ein, um sie trotzdem ohne Pruning zu kopieren: "

#: chain-tower.sh:381
msgid "Where should the blockchain be pruned to Server B's size (%s MB) for the watchtower?"
msgstr "Wo soll die Blockchain für den Watchtower auf die Größe von Server B (%s MB) gepruned werden?"

#: chain-tower.sh:382
msgid "  1. On Server A: a pruned copy is made beside BTCPay's, and only that is sent (about %s GB)."
msgstr "  1. Auf Server A: Neben der von BTCPay wird eine geprunte Kopie erstellt, und nur sie wird gesendet (etwa %s GB)."

#: chain-tower.sh:383
msgid "     BTCPay's own blockchain isn't changed. Needs about %s GB free here meanwhile."
msgstr "     Die Blockchain von BTCPay selbst bleibt unverändert. Braucht hier währenddessen etwa %s GB freien Platz."

#: chain-tower.sh:384
msgid "  2. On Server B: BTCPay's whole pruned blockchain is sent (%s GB), and Server B prunes it"
msgstr "  2. Auf Server B: Die ganze geprunte Blockchain von BTCPay wird gesendet (%s GB), und Server B prunt sie"

#: chain-tower.sh:385
msgid "     after the import. Nothing extra on this server; more to send, more room on Server B."
msgstr "     nach dem Import. Hier kein zusätzlicher Platz nötig; mehr zu senden, mehr Platz auf Server B nötig."

#: chain-tower.sh:387 serverb-scripts.sh:209 setup_script.sh:778
msgid "Choose 1 or 2: "
msgstr "Wählen Sie 1 oder 2: "

#: chain-tower.sh:405
msgid "❌ Not enough space on Server A for the pruned copy: %s GB needed in %s, %s GB free."
msgstr "❌ Nicht genug Platz auf Server A für die geprunte Kopie: %s GB nötig in %s, %s GB frei."

#: chain-tower.sh:407
msgid "   Free some space, or choose 2 (pruned on Server B)."
msgstr "   Schaffen Sie etwas Platz, oder wählen Sie 2 (gepruned auf Server B)."

#: chain-tower.sh:419
msgid "❌ Not enough space on Server B: the copy needs %s GB in ~%s (with 5 GB kept free), %s GB free there."
msgstr "❌ Nicht genug Platz auf Server B: Die Kopie braucht %s GB in ~%s (wobei 5 GB frei bleiben), dort sind %s GB frei."

#: chain-tower.sh:421
msgid "   The import moves it to /var/lib, another disk there: %s GB needed, %s GB free."
msgstr "   Der Import verschiebt sie nach /var/lib, dort ein anderer Datenträger: %s GB nötig, %s GB frei."

#: chain-tower.sh:423
msgid "   Choose 1 (pruned on Server A) to send less, or free space on Server B."
msgstr "   Wählen Sie 1 (gepruned auf Server A), um weniger zu senden, oder schaffen Sie Platz auf Server B."

#: chain-tower.sh:427
msgid "✅ Room enough: Server B has %s GB free for %s GB."
msgstr "✅ Genug Platz: Server B hat %s GB frei für %s GB."

#: chain-tower.sh:430 chain-tower.sh:435
msgid "Two passes, so BTCPay is down only for the second:"
msgstr "Zwei Durchgänge, damit BTCPay nur während des zweiten offline ist:"

#: chain-tower.sh:431
msgid "  1. while BTCPay runs: the pruned copy is made here (the chainstate copied, about %s GB)."
msgstr "  1. Während BTCPay läuft: Die geprunte Kopie wird hier erstellt (der Chainstate kopiert, etwa %s GB)."

#: chain-tower.sh:432 chain-tower.sh:438
msgid "  2. BTCPay stopped (you type STOP BTCPAY): only what changed meanwhile, usually minutes."
msgstr "  2. BTCPay gestoppt (Sie geben STOP BTCPAY ein): nur was sich inzwischen geändert hat, meist Minuten."

#: chain-tower.sh:433
msgid "     Then BTCPay starts again, the copy is pruned and sent to Server B, and deleted here."
msgstr "     Danach startet BTCPay wieder, die Kopie wird gepruned, an Server B gesendet und hier gelöscht."

#: chain-tower.sh:436
msgid "  1. while BTCPay runs: almost everything (%s GB). This can take hours; BTCPay keeps working."
msgstr "  1. Während BTCPay läuft: fast alles (%s GB). Das kann Stunden dauern; BTCPay arbeitet weiter."

#: chain-tower.sh:437
msgid "     If the connection drops, run /chain copy again: it goes on where it stopped."
msgstr "     Bricht die Verbindung ab, führen Sie /chain copy erneut aus: Es macht dort weiter, wo es aufhörte."

#: chain-tower.sh:439
msgid "     Then BTCPay starts again."
msgstr "     Danach startet BTCPay wieder."

#: chain-tower.sh:441
msgid "Server B's gate takes it only into ~%s/chain-incoming (serverb-bitcoind-setup.sh makes it)."
msgstr "Das Gate von Server B nimmt sie nur in ~%s/chain-incoming an (serverb-bitcoind-setup.sh legt es an)."

#: chain-tower.sh:442
msgid "Afterwards, on Server B: sudo bash serverb-import-chain.sh"
msgstr "Danach auf Server B: sudo bash serverb-import-chain.sh"

#: chain-tower.sh:443
msgid "Start the copy? Type yes: "
msgstr "Kopie starten? Geben Sie yes ein: "

#: chain-tower.sh:453
msgid "📦 Pass 1 of 2: making the pruned copy in %s while BTCPay runs..."
msgstr "📦 Durchgang 1 von 2: Die geprunte Kopie wird in %s erstellt, während BTCPay läuft..."

#: chain-tower.sh:456
msgid "Making the copy failed, so BTCPay was not stopped. Free space in %s, then run /chain copy again."
msgstr "Erstellen der Kopie fehlgeschlagen, daher wurde BTCPay nicht gestoppt. Schaffen Sie Platz in %s und führen Sie dann /chain copy erneut aus."

#: chain-tower.sh:459
msgid "📤 Pass 1 of 2: copying while BTCPay runs..."
msgstr "📤 Durchgang 1 von 2: Kopieren, während BTCPay läuft..."

#: chain-tower.sh:465
msgid "⚠️ Pass 1 ended with code %s (files changing while BTCPay runs, expected). Going on to pass 2, which copies the rest."
msgstr "⚠️ Durchgang 1 endete mit Code %s (Dateien ändern sich, während BTCPay läuft, das ist normal). Weiter mit Durchgang 2, der den Rest kopiert."

#: chain-tower.sh:466
msgid "Pass 1 failed (rsync exit code %s), so BTCPay was not stopped. Fix what the lines above say, then run /chain copy again."
msgstr "Durchgang 1 fehlgeschlagen (rsync-Exit-Code %s), daher wurde BTCPay nicht gestoppt. Beheben Sie, was die Zeilen oben nennen, und führen Sie dann /chain copy erneut aus."

#: chain-tower.sh:469
msgid "a few minutes, while the rest of the blockchain is copied"
msgstr "einige Minuten, während der Rest der Blockchain kopiert wird"

#: chain-tower.sh:472
msgid "🛑 Stopping BTCPay (btcpay-down.sh)..."
msgstr "🛑 BTCPay wird gestoppt (btcpay-down.sh)..."

#: chain-tower.sh:473
msgid "btcpay-down.sh failed"
msgstr "btcpay-down.sh fehlgeschlagen"

#: chain-tower.sh:475
msgid "📦 Pass 2 of 2: the rest, with BTCPay stopped..."
msgstr "📦 Durchgang 2 von 2: der Rest, bei gestopptem BTCPay..."

#: chain-tower.sh:476
msgid "Making the copy failed. BTCPay is started again; run /chain copy again later."
msgstr "Erstellen der Kopie fehlgeschlagen. BTCPay wird wieder gestartet; führen Sie /chain copy später erneut aus."

#: chain-tower.sh:477
msgid "🚀 Starting BTCPay again..."
msgstr "🚀 BTCPay wird wieder gestartet..."

#: chain-tower.sh:478
msgid "❌ btcpay-up.sh failed: run %s/btcpay-up.sh by hand"
msgstr "❌ btcpay-up.sh fehlgeschlagen: Führen Sie %s/btcpay-up.sh von Hand aus"

#: chain-tower.sh:482
msgid "📤 Sending the pruned copy (%s GB) to Server B..."
msgstr "📤 Die geprunte Kopie (%s GB) wird an Server B gesendet..."

#: chain-tower.sh:483
msgid "Sending the copy failed. Run /chain copy again later (BTCPay keeps running)."
msgstr "Senden der Kopie fehlgeschlagen. Führen Sie /chain copy später erneut aus (BTCPay läuft weiter)."

#: chain-tower.sh:485
msgid "📤 Pass 2 of 2: copying the rest with BTCPay stopped..."
msgstr "📤 Durchgang 2 von 2: Kopieren des Rests bei gestopptem BTCPay..."

#: chain-tower.sh:486
msgid "Pass 2 failed. BTCPay is started again; run /chain copy again later."
msgstr "Durchgang 2 fehlgeschlagen. BTCPay wird wieder gestartet; führen Sie /chain copy später erneut aus."

#: chain-tower.sh:488
msgid "✅ Blockchain copied to Server B. Next, on Server B: sudo bash serverb-import-chain.sh"
msgstr "✅ Blockchain auf Server B kopiert. Als Nächstes auf Server B: sudo bash serverb-import-chain.sh"

#: chain-tower.sh:493
msgid "WATCHTOWER_PUBKEY in config isn't a public key (66 hex characters)"
msgstr "WATCHTOWER_PUBKEY in config ist kein öffentlicher Schlüssel (66 Hex-Zeichen)"

#: chain-tower.sh:494
msgid "WATCHTOWER_IP in config isn't set"
msgstr "WATCHTOWER_IP ist in config nicht gesetzt"

#: chain-tower.sh:495
msgid "WATCHTOWER_PORT in config isn't a port"
msgstr "WATCHTOWER_PORT in config ist kein Port"

#: chain-tower.sh:499
msgid "BTCPay's LND has its watchtower client off. BTCPay's opt-lnd-wtclient fragment turns it on"
msgstr "Beim LND von BTCPay ist der Watchtower-Client aus. Das BTCPay-Fragment opt-lnd-wtclient schaltet ihn ein"

#: chain-tower.sh:500
msgid "(wtclient.active=1); btcpay-setup.sh applies it and restarts LND."
msgstr "(wtclient.active=1); btcpay-setup.sh wendet es an und startet LND neu."

#: chain-tower.sh:501
msgid "a few minutes, while btcpay-setup.sh turns on the watchtower client"
msgstr "einige Minuten, während btcpay-setup.sh den Watchtower-Client einschaltet"

#: chain-tower.sh:505
msgid "⏳ Waiting for LND..."
msgstr "⏳ Warten auf LND..."

#: chain-tower.sh:506
msgid "LND doesn't answer (docker logs %s)"
msgstr "LND antwortet nicht (docker logs %s)"

#: chain-tower.sh:509
msgid "⏳ LND is still catching up with the chain; the watchtower client waits for that (up to 10 minutes here)..."
msgstr "⏳ LND holt die Blockchain noch auf; der Watchtower-Client wartet darauf (hier bis zu 10 Minuten)..."

#: chain-tower.sh:511
msgid "➕ Adding the watchtower %s..."
msgstr "➕ Watchtower %s wird hinzugefügt..."

#: chain-tower.sh:519
msgid "LND's watchtower client didn't answer within 10 minutes (LND not synced to the chain yet?). The client is on; run /tower add again later."
msgstr "Der Watchtower-Client von LND hat nicht innerhalb von 10 Minuten geantwortet (LND noch nicht mit der Blockchain synchron?). Der Client ist eingeschaltet; führen Sie /tower add später erneut aus."

#: chain-tower.sh:520
msgid "lncli wtclient add failed"
msgstr "lncli wtclient add fehlgeschlagen"

#: chain-tower.sh:522
msgid "✅ The watchtower is added. LND sends it encrypted channel updates from now on."
msgstr "✅ Der Watchtower ist hinzugefügt. LND sendet ihm ab jetzt verschlüsselte Kanal-Updates."

#: chain-tower.sh:530
msgid "The watchtower client isn't on, LND isn't running, or LND is still catching up with the chain:"
msgstr "Der Watchtower-Client ist aus, LND läuft nicht, oder LND holt die Blockchain noch auf:"

#: chain-tower.sh:534
msgid "Towers:"
msgstr "Tower:"

#: chain-tower.sh:536
msgid "Statistics:"
msgstr "Statistik:"

#: config-lib.sh:17
msgid "❌ %s can't hold \", $, `, \\ or control characters: %s"
msgstr "❌ %s darf keine \", $, `, \\ oder Steuerzeichen enthalten: %s"

#: config-lib.sh:21 config-lib.sh:46
msgid "❌ Expected exactly one %s= line in %s"
msgstr "❌ Erwartet wurde genau eine Zeile %s= in %s"

#: config-lib.sh:29
msgid "❌ Could not write %s (the original is saved in %s)"
msgstr "❌ %s konnte nicht geschrieben werden (das Original liegt in %s)"

#: config-lib.sh:35
msgid "❌ Failed to reload %s with %s=\"%s\""
msgstr "❌ %s konnte mit %s=\"%s\" nicht neu geladen werden"

#: config-lib.sh:38
msgid "✅ Saved %s=\"%s\" in %s"
msgstr "✅ %s=\"%s\" in %s gespeichert"

#: config-lib.sh:65 rsync_gpg_backup.sh:302
msgid "❌ Not allowed: %s"
msgstr "❌ Nicht erlaubt: %s"

#: config-lib.sh:74
msgid "❌ %s in config is not allowed: %s"
msgstr "❌ %s in config ist nicht erlaubt: %s"

#: config-lib.sh:83
msgid "enter a hostname or IP address (letters, digits, '.', ':' and '-', no user@ or spaces)"
msgstr "geben Sie einen Hostnamen oder eine IP-Adresse ein (Buchstaben, Ziffern, '.', ':', '-', ohne user@ und Leerzeichen)"

#: config-lib.sh:91 serverb-lib.sh:37
msgid "use up to 32 lowercase letters, digits, _ or -, starting with a letter"
msgstr "verwenden Sie bis zu 32 Kleinbuchstaben, Ziffern, _ oder -, beginnend mit einem Buchstaben"

#: config-lib.sh:93
msgid "use an account of its own on Server B, not root, bitcoin or lndtower"
msgstr "verwenden Sie ein eigenes Konto auf Server B, nicht root, bitcoin oder lndtower"

#: config-lib.sh:100
msgid "enter a port number from 1 to 65535"
msgstr "geben Sie eine Portnummer von 1 bis 65535 ein"

#: config-lib.sh:183
msgid "❌ Could not add the new settings to %s"
msgstr "❌ Die neuen Einstellungen konnten nicht zu %s hinzugefügt werden"

#: config-lib.sh:189
msgid "❌ Failed to reload %s after adding new settings"
msgstr "❌ %s konnte nach dem Hinzufügen der neuen Einstellungen nicht neu geladen werden"

#: config-lib.sh:192
msgid "✅ Updated %s: %s"
msgstr "✅ %s aktualisiert: %s"

#: install-scripts.sh
msgid "❌ %s has a syntax error"
msgstr "❌ %s hat einen Syntaxfehler"

#: install-scripts.sh
msgid "❌ Missing %s/%s"
msgstr "❌ %s/%s fehlt"

#: install-scripts.sh
msgid "❌ Missing %s/LICENSE"
msgstr "❌ %s/LICENSE fehlt"

#: install-scripts.sh
msgid "❌ Missing %s/release-key.asc"
msgstr "❌ %s/release-key.asc fehlt"

#: install-scripts.sh:57
msgid "❌ BACKUP_INSTALL_DIR must be under /usr/local or /opt: %s"
