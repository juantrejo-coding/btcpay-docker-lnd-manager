msgstr "   sudo ./serverb-setup.sh %s"

#: serverb-scripts.sh:247
msgid "   sudo -u %s cat ~%s/serverb-setup/serverb-install.sh > serverb-install.sh"
msgstr "   sudo -u %s cat ~%s/serverb-setup/serverb-install.sh > serverb-install.sh"

#: serverb-scripts.sh:248
