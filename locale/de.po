msgstr "  Hängen Sie ihn nicht selbst ein, tragen Sie ihn nicht in /etc/fstab ein: Das macht das Setup, unter %s"

#: setup_script.sh:492
msgid "  (owned by root, with %s), and gives the backup user only"
msgstr "  (gehört root, mit %s), und es gibt dem Backup-Benutzer darauf nur"

#: setup_script.sh:493
msgid "  the %s folder on it."
msgstr "  den Ordner %s."

#: setup_script.sh:497
